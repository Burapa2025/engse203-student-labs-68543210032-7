# ค่า config ของ API — คัดลอกเป็น .env ของเครื่องตัวเอง (npm run dev อ่านไฟล์นี้ผ่าน --env-file)
# กติกา (CP52): .env ห้าม commit (อยู่ใน .gitignore) · ไฟล์นี้ commit ได้เพราะไม่มีค่าลับจริง

NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173

# 🔑 secret สำหรับเซ็น JWT — ห้ามเว้นว่างตอน production (ระบบจะไม่ยอม start ถ้าไม่มี)
# สร้างค่าสุ่มสำหรับ .env ของเครื่องตัวเอง:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=2h
